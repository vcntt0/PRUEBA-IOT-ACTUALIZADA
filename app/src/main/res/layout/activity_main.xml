<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center_horizontal">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Control de Basurero Inteligente"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="48dp"/>

    <Button
        android:id="@+id/btnConnectBluetooth"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Conectar al Basurero (Bluetooth)" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Estado: Desconectado"
        android:textSize="16sp"
        android:layout_marginTop="16dp"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnSimulateData"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Leer Nivel de Basura y Proximidad" />

</LinearLayout>